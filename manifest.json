{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "1.5.0",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "chatkit-pro@justplguy",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "action": {
    "default_title": "ChatKit Pro by JustPLGuy",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_area": "navbar"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/core.js",
        "src/i18n.js",
        "src/i18n-more.js",
        "src/dom.js",
        "src/export.js",
        "src/timestamps.js",
        "src/theme.js",
        "src/sidebar.js",
        "src/search.js",
        "src/panel.js",
        "src/prompts.js",
        "src/minimap.js",
        "src/code.js",
        "src/tabs-extra.js",
        "src/composer.js",
        "src/follow.js",
        "src/palette.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
